# Local computer-vision data and weights (not committed)
KNOWN_FACES_DIR=known_faces
UPLOAD_FOLDER=uploads
REFLECTOR_MODEL=yolo_reflector_model/weights/best.pt
EMOTION_MODEL=faceemotion.pt
WEAPON_MODEL=gun_detection/gun.pt
