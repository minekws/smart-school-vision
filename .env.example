# Core web service
APP_HOST=0.0.0.0
APP_PORT=8005
DB_PATH=sessions.db
USERS_FILE=users/users.json
IMAGE_FOLDER=static/images
BASE_DATA_DIR=data
LIST_DIR=lists
FACE_API_BASE=http://127.0.0.1:5000
ALLOWED_ORIGINS=["http://127.0.0.1:8005","http://localhost:8005"]
